{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 3 * * 1"
    }
  ]
}
